# Copy these values into a real .env file (or export them in the shell).
# docker compose reads .env automatically.

# Ollama endpoint the app talks to. With docker compose this is set internally;
# for bare-metal keep the default.
OLLAMA_HOST=http://localhost:11434

# Real models the pipeline always uses.
MORPHIX_THINKER_MODEL=deepseek-r1:1.5b
MORPHIX_BUILDER_MODEL=qwen2.5-coder:7b

# Strict mode: never fall back to rule-based plans or template geometry.
# Model failures fail the run loudly. Keep it true for deployment.
MORPHIX_STRICT_MODELS=true

# How many times the builder is re-asked per block when validation rejects its
# output before the run fails (strict mode).
MORPHIX_BUILDER_RETRIES=2

# Seconds to wait for a single model call before treating Ollama as unreachable.
MORPHIX_OLLAMA_TIMEOUT=180

# HTTP port the app binds to.
PORT=5000

# gunicorn tuning (only used when run through gunicorn.conf.py)
WORKERS=1
THREADS=8